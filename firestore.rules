rules_version = '2';

// Règles publiées sur Firebase pour Corona Saintes.
// Lecture/écriture ouvertes (pas de compte) uniquement pour les données du site,
// rangées sous /groups. Tout le reste de la base est fermé.
service cloud.firestore {
  match /databases/{database}/documents {
    match /groups/{document=**} {
      allow read, write: if true;
    }
  }
}
